# Selecciona: openai o anthropic
LLM_PROVIDER=openai

# Opcional. Si se omite, se usa el modelo predeterminado del proveedor.
LLM_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Define solamente la clave del proveedor seleccionado.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
